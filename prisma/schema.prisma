// Schema base do EVOLUI para Turso/libSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Profile {
  id        String   @id
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  records   Record[]
}

model Activity {
  id        String   @id @default(cuid())
  name      String
  category  String
  createdBy String?
  createdAt DateTime @default(now())
  records   Record[]

  @@index([createdBy])
}

model Record {
  id           String    @id @default(cuid())
  userId       String
  type         String
  activityId   String?
  activityName String?
  recordDate   DateTime
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  profile      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity     Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  media        Media[]

  @@index([userId, recordDate])
  @@index([activityId])
}

model Media {
  id          String   @id @default(cuid())
  recordId    String
  type        String
  storagePath String
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  record      Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, orderIndex])
}
