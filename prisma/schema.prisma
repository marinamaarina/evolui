// Schema base do EVOLUI.
// Nesta etapa só configuramos a conexão com o banco Turso.
// Os models (Profile, Activity, Record, Media, Analysis) entram na etapa 3,
// junto com as migrations e as políticas de Row Level Security.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}
