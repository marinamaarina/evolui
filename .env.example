# Copie este arquivo para .env.local e preencha com os valores dos seus
# projetos Turso e Supabase.

# --- Supabase Auth / Storage (client + server) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role — NUNCA expor no client, só usada em código de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Banco de dados Turso (Prisma + libSQL) ---
TURSO_DATABASE_URL=libsql://seu-banco-seu-org.turso.io
TURSO_AUTH_TOKEN=
