# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Supabase (Project Settings -> API, e Project Settings -> Database).

# --- Supabase Auth / Storage (client + server) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role — NUNCA expor no client, só usada em código de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Banco de dados (Prisma) ---
# Connection string "pooled" (pgbouncer) da Supabase — usada em runtime.
DATABASE_URL=

# Connection string direta (sem pooling) — usada pelo Prisma para migrations.
DIRECT_URL=
